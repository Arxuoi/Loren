diff --git a/clang/include/clang/Driver/Options.td b/clang/include/clang/Driver/Options.td
index 8177989..f9bfdae 100644
--- a/clang/include/clang/Driver/Options.td
+++ b/clang/include/clang/Driver/Options.td
@@ -5847,3 +5847,12 @@ def _SLASH_Ze : CLFlag<"Ze">;
 def _SLASH_Zg : CLFlag<"Zg">;
 def _SLASH_ZI : CLFlag<"ZI">;
 def _SLASH_ZW : CLJoined<"ZW">;
+
+// Nero native driver profiles.
+def fnero_fast : Flag<["-"], "fnero-fast">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Nero speed profile (LLVM -O3)">;
+def fnero_max : Flag<["-"], "fnero-max">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Nero maximum speed profile (-O3 and full LTO)">;
+def fnero_secure : Flag<["-"], "fnero-secure">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Nero userspace hardening profile">;
+def fnero_size : Flag<["-"], "fnero-size">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Nero minimum-size profile (LLVM -Oz)">;
+def fnero_kernel : Flag<["-"], "fnero-kernel">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Nero kernel compatibility mode">;
+def fnero_gki : Flag<["-"], "fnero-gki">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Nero Android GKI compatibility mode">;
+def fnero_diagnostics : Flag<["-"], "fnero-diagnostics">, Group<f_Group>, Flags<[NoArgumentUnused]>, HelpText<"Enable optional Nero diagnostics">;
diff --git a/clang/tools/driver/CMakeLists.txt b/clang/tools/driver/CMakeLists.txt
index 01efebd..04d0135 100644
--- a/clang/tools/driver/CMakeLists.txt
+++ b/clang/tools/driver/CMakeLists.txt
@@ -62,6 +62,9 @@ if(NOT CLANG_LINKS_TO_CREATE)
   set(CLANG_LINKS_TO_CREATE clang++ clang-cl clang-cpp)
 endif()
 
+list(APPEND CLANG_LINKS_TO_CREATE neroclang neroclang++ neroclang-pp)
+install(PROGRAMS ${CMAKE_SOURCE_DIR}/../nero/cli/nero.py DESTINATION bin RENAME nero COMPONENT clang)
+
 foreach(link ${CLANG_LINKS_TO_CREATE})
   add_clang_symlink(${link} clang)
 endforeach()
diff --git a/clang/tools/driver/driver.cpp b/clang/tools/driver/driver.cpp
index f67af67..7d467aa 100644
--- a/clang/tools/driver/driver.cpp
+++ b/clang/tools/driver/driver.cpp
@@ -452,6 +452,34 @@ int main(int argc_, const char **argv_) {
   }
 
   std::string Path = GetExecutablePath(argv[0], CanonicalPrefixes);
+  StringRef NeroName = llvm::sys::path::filename(argv[0]);
+  bool NeroPP = NeroName.startswith("neroclang-pp");
+  bool Nero = NeroPP || NeroName.startswith("neroclang");
+  bool KernelMode = llvm::is_contained(argv, StringRef("-fnero-kernel")) ||
+                    llvm::is_contained(argv, StringRef("-fnero-gki"));
+  bool HasOpt = llvm::any_of(argv, [](StringRef A) {
+    return A == "-O0" || A == "-O1" || A == "-O2" || A == "-O3" ||
+           A == "-Os" || A == "-Oz" || A == "-Ofast";
+  });
+  if (Nero && !KernelMode && !HasOpt) {
+    if (llvm::is_contained(argv, StringRef("-fnero-size"))) argv.push_back("-Oz");
+    else if (NeroPP || llvm::is_contained(argv, StringRef("-fnero-fast")) ||
+             llvm::is_contained(argv, StringRef("-fnero-max"))) argv.push_back("-O3");
+    else argv.push_back("-O2");
+  }
+  if (!KernelMode && llvm::is_contained(argv, StringRef("-fnero-max")))
+    argv.push_back("-flto");
+  if (!KernelMode && llvm::is_contained(argv, StringRef("-fnero-secure"))) {
+    argv.push_back("-fstack-protector-strong"); argv.push_back("-D_FORTIFY_SOURCE=2");
+  }
+  if (Nero && llvm::is_contained(argv, StringRef("--version"))) {
+    llvm::outs() << (NeroPP ? "Nero Clang PlusPlus 1.0.0\nPerformance Edition\n"
+                            : "Nero Clang 1.0.0\n")
+                 << "Based on LLVM/Clang 12.0.1\nTarget: "
+                 << llvm::sys::getDefaultTargetTriple()
+                 << "\nNero Compiler Project\n";
+    return 0;
+  }
 
   // Whether the cc1 tool should be called inside the current process, or if we
   // should spawn a new clang subprocess (old behavior).
